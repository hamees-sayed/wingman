# Copy to .env and fill in. Nothing here is committed.

# --- Required ---------------------------------------------------------------------------------
OPENAI_API_KEY=            # models for whispers, recaps and the agent
SMALLEST_API_KEY=          # Smallest AI: Pulse speech-to-text and Lightning text-to-speech
CONVEX_URL=                # your Convex deployment, e.g. https://xxx.convex.cloud (npx convex dev prints it)
WINGMAN_KEY=               # any long random string; the app must be built with the same one
PUBLIC_URL=                # the https address the server is reached at, e.g. https://wingman.example.com

# --- Connections (each is optional; the app shows what is set up) -----------------------------
GOOGLE_CLIENT_ID=          # Google Cloud OAuth web client: Calendar, Drive, Gmail and People APIs enabled
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=           # a Slack app with user-token scopes; add PUBLIC_URL/oauth/slack/callback as a redirect URL
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=        # PUBLIC_URL/oauth/slack/callback
NOTION_CLIENT_ID=          # a public Notion integration
NOTION_CLIENT_SECRET=
NOTION_TOKEN=              # optional: an internal integration secret, used for the first owner only
SUPERMEMORY_API_KEY=       # optional: search facts and past conversations by meaning

# --- Optional -----------------------------------------------------------------------------------
STT_LANGUAGE=en            # "multi" also hears Hindi
WINGMAN_AGENT_MODEL=       # default gpt-5.4-mini (the agent you talk to)
WINGMAN_GATE_MODEL=        # default gpt-6-luna (whispers)
WINGMAN_THINK_MODEL=       # default gpt-6-luna (recaps, profile)
WINGMAN_TRUST_LAN=         # 1 lets devices on the server's own network in without the key (a laptop at home)
WINGMAN_HOST=              # user@host for scripts/deploy.sh
WINGMAN_SSH_KEY=           # ssh key for scripts/deploy.sh
